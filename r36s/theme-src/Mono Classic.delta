# Mono Classic -- generated by build.py extract; edit and re-run build.

@name    Mono Classic
@family  Mono (iPod Classic look: white, gray chrome title bar, blue gradient selection bars (work in progress))

[carousel systemcarousel]
logoSize = 0.453125 0.15   ## row 72px tall; indent = 0.453125x640/10 = 29px (rendered Figma: row x4 + 25px pad)
pos = 0 0.0958333   ## Figma: rows region top 46px -> rows land at y 48/124/200/276/352
selectorColor = 4FA0F0FF   ## iPod blue gradient (top)
selectorColorEnd = 1257C9FF @after selectorColor   ## iPod blue gradient (bottom); needs the gradient-capable ES build
selectorWidth = 1.0   ## full-width bar (authentic iPod)
selectorRadius = 0.0   ## square bar (authentic iPod)
logoColor = 000000FF   ## unselected rows: off-white (#E0E0E0)
logoSelectedColor = FFFFFFFF   ## selected row: white on the blue bar

[text logoText #0]
color = 000000   ## off-white (#E0E0E0); selected row overridden to black by logoSelectedColor

[text systemInfo]
backgroundColor = FFFFFF

[helpsystem help #0]
textColor = 000000
backgroundColor = E6E6E6FF   ## iPod: light gray pill --><!-- 10% black on E0E0E0 paper (mirrors Figma 10% white)

[helpsystem help #1]
textColor = 000000
backgroundColor = E6E6E6FF   ## iPod: light gray pill --><!-- 10% black on E0E0E0 paper (mirrors Figma 10% white)

[textlist gamelist]
selectorColor = 4FA0F0FF   ## iPod blue gradient (top)
selectorColorEnd = 1257C9FF @after selectorColor   ## iPod blue gradient (bottom)
selectedColor = FFFFFF   ## white text on the blue bar
primaryColor = 000000   ## unselected game text: off-white
secondaryColor = 000000
pos = 0 0.10625   ## left edge 4px; top 51px -> text rows land at 64+54k (measured on device)
size = 1.0 0.7875   ## pill width 632px (4px each side); 378px = 7 rows x 54px pitch (Figma)
horizontalMargin = 0.03125   ## 16px text inset inside the pill (Figma px-16)
lineSpacing = 1.641   ## row pitch 54px (BPreplay-Bold@32 glyph height measures 32.9px on device)
selectorRadius = 0.0   ## square bar (authentic iPod)

[text logoText #1]
color = 000000

[menuText menutext]
color = 000000   ## unselected menu row: off-white
selectorColor = 4FA0F0FF   ## iPod blue gradient (top)
selectorColorEnd = 1257C9FF @after selectorColor   ## iPod blue gradient (bottom)
selectedColor = FFFFFF   ## white text on the blue bar
selectorRadius = 0.0   ## square full-width bar (authentic iPod)
separatorColor = C8C8C8FF   ## thin row separators (iPod)

[menuText menutitle]
color = 000000

[menuText menufooter]
color = 000000   ## off-white version text

[menuText menutextsmall]
color = 000000

[text clock]
color = 000000

[batteryIndicator batteryIndicator]
color = 000000

[keyboard keyboard]
keyColor = E0E0E0FF   ## recessed keys on the #F3F3F3 paper; the letters carry the contrast

[text screensaverClock]
[replace text screensaverClock fontSize]
	<fontSize>0.18</fontSize><!-- the digit size, and only the digits: the date row is its own
	     fixed size now. Measured against the Figma frame, where a digit's ink is 86px tall and
	     53px wide; 0.159 rendered it at 76 x 47, so this is that 1.13x short. -->
[end]

[remove subset color-scheme]

[remove include white]

[remove include amber]

[remove include cyan]

[remove include green]

[remove include pink]
