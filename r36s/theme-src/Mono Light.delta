# Mono Light -- generated by build.py extract; edit and re-run build.

@name    Mono Light
@family  Mono (Mono Dark inverted onto #E0E0E0 paper)

[carousel systemcarousel]
selectorColor = 000000FF   ## off-white pill (#E0E0E0, matches design)
logoColor = 000000FF   ## unselected rows: off-white (#E0E0E0)
logoSelectedColor = E0E0E0FF   ## selected row: black on the pill

[text logoText #0]
color = 000000   ## off-white (#E0E0E0); selected row overridden to black by logoSelectedColor

[text systemInfo]
backgroundColor = E0E0E0

[helpsystem help #0]
textColor = 000000
backgroundColor = CACACAFF   ## 10% black on E0E0E0 paper (mirrors Figma 10% white)

[helpsystem help #1]
textColor = 000000
backgroundColor = CACACAFF   ## 10% black on E0E0E0 paper (mirrors Figma 10% white)

[textlist gamelist]
selectorColor = 000000   ## off-white pill (#E0E0E0)
selectedColor = E0E0E0   ## black text on the pill
primaryColor = 000000   ## unselected game text: off-white
secondaryColor = 000000

[text logoText #1]
color = 000000

[menuText menutext]
color = 000000   ## unselected menu row: off-white
selectorColor = 000000   ## off-white pill (#E0E0E0) on selected menu row
selectedColor = E0E0E0   ## black text on the pill

[menuText menutitle]
color = 000000

[menuText menufooter]
color = 000000   ## off-white version text

[menuText menutextsmall]
color = 000000

[text clock]
color = 000000

[batteryIndicator batteryIndicator]
color = 000000

[keyboard keyboard]
keyColor = FFFFFFFF   ## near-white keys on the #E0E0E0 paper; the letters carry the contrast

[text screensaverClock]
[replace text screensaverClock fontSize]
	<fontSize>0.18</fontSize><!-- the digit size, and only the digits: the date row is its own
	     fixed size now. Measured against the Figma frame, where a digit's ink is 86px tall and
	     53px wide; 0.159 rendered it at 76 x 47, so this is that 1.13x short. -->
[end]
