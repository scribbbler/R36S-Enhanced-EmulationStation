# Mono Max -- generated by build.py extract; edit and re-run build.

@name    Mono Dark
@family  Mono (the Mono family flagship: black, text-only, capsule selection)

[image logo]
path = ./system/${system.theme}.svg

[carousel systemcarousel]
[replace carousel systemcarousel logoSize]
	<logoSize>0.76 0.1466667</logoSize><!-- 486x70 is the UNSELECTED box; logoScale below takes the
	     selected row to 608x88, centred at (640-608)/2 = 16px, so 8px inside the 624px pill on
	     each side and 8px of pill above and below.
	     The logos are tight-cropped, so this box IS the drawn size, and WIDTH is what limits
	     most of them: the set runs to 10.9:1, so at 320px wide the widest draw 29px however
	     tall the box gets. Centring is what buys the width -- a left-aligned vertical carousel
	     derives its indent from logoSize.x/10 with no logoPos override, so widening pushed the
	     logos right; a centred one uses (size.x - logoSize.x)/2 and has no such tie. Measured
	     across the 152 system logos: 320x48 spans 29-48px, 512x72 spans 47-72px, this spans
	     56-72px. Row pitch and pill are independent (size.y/maxLogoCount, selectorHeight). -->
[end]
[replace carousel systemcarousel logoScale]
	<logoScale>1.25</logoScale><!-- the selected row draws a quarter larger than the rest.
	     SystemView fits EVERY logo to logoSize * logoScale and then divides the per-row scale by
	     logoScale again, so the selected row lands at logoSize * logoScale and the others at
	     logoSize. logoSize above is therefore the unselected size, not the maximum. -->
[end]
[replace carousel systemcarousel maxLogoCount]
	<maxLogoCount>3</maxLogoCount><!-- 3 rows visible, selected centered: 380/3 = 127px pitch, the
	     room a 72px logo needs. At 5 rows the pitch was 76px and the box could not grow. -->
[end]
[replace carousel systemcarousel logoAlignment]
	<logoAlignment>center</logoAlignment><!-- centred in the pill: SystemView puts the logo's own
	     centre at (size.x - logoSize.x)/2 + logoSize.x/2 = 320, the pill's centre. Also frees
	     logoSize.x from the indent, which is why the box can be 608 wide. -->
[end]
size = 1 0.7916667   ## 380px -> row pitch 380/3 = 127px
[replace carousel systemcarousel selectorHeight]
	<selectorHeight>0.2166667</selectorHeight><!-- pill 104px: grown with the pitch, so three rows
	     read as a list rather than as three 72px pills adrift in 127px of black -->
[end]
selectorRadius = 0.1083333   ## full pill (half of 104px)

[text logoText #0]
[replace text logoText #0 fontSize]
	<fontSize>0.089</fontSize><!-- 56px design ÷ 1.31 engine boost = 42.7px nominal. Bigger than the
	     name themes' 41px on purpose: this is the fallback for the 26 systems with no logo, and it
	     has to hold its own beside a 72px logo rather than match a 41px name. -->
[end]
lineSpacing = 1.171   ## line height 66px
alignment = center   ## matches logoAlignment, so a system with no logo centres like one with

[textlist gamelist]
[replace textlist gamelist alignment]
         <alignment>center</alignment><!-- Max centres its game names too, so the gamelist reads the
              same way as the carousel it was reached from -->
[end]
[replace textlist gamelist horizontalMargin]
         <horizontalMargin>0.025</horizontalMargin><!-- 16px inset each side, so a long name stops short
              of the pill edge instead of running into the radius -->
[end]

[text screensaverClock]
[replace text screensaverClock fontSize]
	<fontSize>0.18</fontSize><!-- the digit size, and only the digits: the date row is its own
	     fixed size now. Measured against the Figma frame, where a digit's ink is 86px tall and
	     53px wide; 0.159 rendered it at 76 x 47, so this is that 1.13x short. -->
[end]

[insert before carousel systemcarousel]
    <!-- Mono Max: the system's logo instead of its name. ES falls back to
         logoText for any system with no file here, so the two coexist. -->
    <image name="logo">
	<path>./system/${system.theme}.svg</path>
    </image>

[end]
